# Optional: use for local dev. Or use Doppler (doppler run -- py run.py) - see README.
# Copy to .env and fill in values. No spaces around =. No quotes unless the value has spaces.

# Telegram bot token from @BotFather (e.g. 7123456789:AAHx...)
TELEGRAM_BOT_TOKEN=your_token_here

# Housecall Pro: use API key (Bearer token) from HCP App Store -> API -> Generate API Key
HCP_API_KEY=your_hcp_key_here

# Optional: restrict bot to specific Telegram user IDs (comma-separated). Leave empty to allow all.
# ALLOWED_TELEGRAM_IDS=123456789,987654321

# Optional LLM: use OpenAI or OpenRouter for natural-language summaries (e.g. job lists).
# Set one of the keys below to enable. If both set, OpenRouter is used.
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# LLM_API_KEY=sk-...   (same as OPENAI_API_KEY, use if you prefer one name)
# Model (optional). If unset: OpenAI uses gpt-4o-mini; OpenRouter uses openai/gpt-4o-mini.
# LLM_MODEL=gpt-4o-mini
